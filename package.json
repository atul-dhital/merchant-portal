{
  "name": "merchant-portal",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "concurrently -k -n api,web -c yellow,cyan \"npm:api\" \"npm:web\"",
    "web": "ng serve",
    "api": "tsx watch mock-api/src/server.ts",
    "build": "ng build",
    "test": "ng test --watch=false",
    "test:watch": "ng test",
    "test:coverage": "ng test --watch=false --coverage",
    "lint": "ng lint && tsc -p mock-api/tsconfig.json"
  },
  "private": true,
  "packageManager": "npm@11.8.0",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "bootstrap": "^5.3.9",
    "rxjs": "~7.8.0",
    "socket.io-client": "^4.8.4",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.30",
    "@angular/cli": "^21.2.30",
    "@angular/compiler-cli": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^4.1.12",
    "angular-eslint": "21.4.0",
    "concurrently": "^10.0.7",
    "cookie-parser": "^1.4.7",
    "eslint": "^10.3.0",
    "express": "^5.3.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "socket.io": "^4.8.4",
    "tsx": "^4.23.15",
    "typescript": "~5.9.2",
    "typescript-eslint": "8.59.2",
    "vitest": "^4.0.8"
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  }
}
